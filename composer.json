{
    "name": "pavansaini596/laravel-idempotent-webhooks",
    "description": "Drop-in idempotency for Laravel webhook controllers — because payment gateways will fire the same webhook three times at 2am.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "webhooks", "idempotency", "payment", "reconciliation"],
    "authors": [
        {
            "name": "Pavan Saini",
            "email": "pavansaini596@gmail.com",
            "homepage": "https://pavansaini.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PavanSaini\\IdempotentWebhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PavanSaini\\IdempotentWebhooks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PavanSaini\\IdempotentWebhooks\\IdempotentWebhooksServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
